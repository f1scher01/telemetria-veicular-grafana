    {
      "id": 101,
      "title": "⚡ Rotação de Pico (RPM) · simulado",
      "description": "Máximo da série sintética de rotação nos últimos 5 minutos. Função geradora: 6200 + 3800·sin(t/4)/2 + 800·cos(t/15), com envelope de 2.400 a 10.800 rpm.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max_over_time((6200 + 3800 * (1 + sin(vector(time() / 4))) * 0.5 + 800 * cos(vector(time() / 15)))[5m:1s])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "color": {
            "mode": "thresholds"
